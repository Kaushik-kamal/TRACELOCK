# ---------------------------------------------------------------------------
# TRACELOCK - Phase 0 configuration
# Copy to .env and fill in.  .env is gitignored; .env.example is committed.
# ---------------------------------------------------------------------------

# REQUIRED. Get a free key (100 searches/month) at https://serpapi.com/manage-api-key
TL_SERPAPI_API_KEY=

# Search engine used by the SerpAPI provider.
#   google_lens   - most reliable schema; finds the SAME image republished
#   yandex_images - best at genuine FACE matching, schema less certain
TL_SERP_ENGINE=google_lens

# Max candidates to request from the provider.
TL_MAX_CANDIDATES=20

# HTTP timeout in seconds for provider + hosting calls.
TL_HTTP_TIMEOUT=30.0

# Where run artifacts are written.
TL_DATA_DIR=data

# Retention for the temporary image host, used ONLY with --allow-upload.
# One of: 1h, 12h, 24h, 72h.  Shortest sensible default on purpose.
TL_UPLOAD_RETENTION=1h

# ---------------------------------------------------------------------------
# BLOCKCHAIN ANCHORING -- TWO MODES
# ---------------------------------------------------------------------------
# TRACELOCK runs with NO configuration here. Leave this whole block untouched
# and it uses the LOCAL DEMO CHAIN: an in-process EVM where anchoring,
# verification and tamper detection all work, at zero cost. The anchor is
# ephemeral -- it resets when the server restarts -- and the interface says so.
#
#   MODE            set                       anchor survives restart?  third party can verify?
#   local demo      nothing (default)         no                        no
#   public          TL_CHAIN + the two below  yes                       yes
#
# Public mode turns on ONLY when the network is public AND both credentials
# are present. Anything missing falls back to the local demo chain with a
# warning in the server log -- it never crashes, and it never claims a public
# anchor it did not make.

# Network: local | amoy | base_sepolia | sepolia
#   local        in-process EVM. Default. No credentials, no explorer.
#   amoy         Polygon Amoy testnet (~2s blocks, Polygonscan)
#   base_sepolia Base Sepolia -- most reliable faucet, no mainnet balance needed
#   sepolia      Ethereum Sepolia
TL_CHAIN=local

# --- required for public mode only -----------------------------------------
# An RPC endpoint for the chosen network (Alchemy, Infura, or a public RPC).
TL_RPC_URL=

# TESTNET private key ONLY. Never a key holding real funds.
# This file is committed; your real values belong in .env, which is gitignored.
# The key is used server-side to sign one transaction and is never sent to the
# browser -- /api/chain/status reports only whether a key is SET.
TL_PRIVATE_KEY=

# Optional: reuse an already-deployed EvidenceNotary contract. When empty,
# scripts/deploy_contract.py deploys one and records the address.
TL_CONTRACT_ADDRESS=

# Confirmations to wait for before treating an anchor as final.
TL_CONFIRMATIONS=1
